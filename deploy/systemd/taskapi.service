[Unit]
Description=DevOps Task API
After=network.target

[Service]
Type=simple
User=taskapi
Group=taskapi
WorkingDirectory=/opt/taskapi
Environment=PORT=3000
Environment=APP_ENV=production
Environment=DATA_DIR=/var/lib/taskapi
# systemd creates /var/lib/taskapi owned by the taskapi user
StateDirectory=taskapi
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
